# -*- mode: python ; coding: utf-8 -*-
"""
PyInstaller spec for Arena.ai Desktop — native Windows app via pywebview + Flask.
Bundles static assets (HTML/CSS/JS) and the full arena package into a single .exe.
"""

import os

a = Analysis(
    ['arena-cli.py'],
    pathex=['.'],
    binaries=[],
    datas=[
        ('arena/web/static', 'arena/web/static'),
        ('assets/logo.svg', 'assets'),
        ('assets/logo.png', 'assets'),
    ],
    hiddenimports=[
        'arena',
        'arena.cli',
        'arena.api',
        'arena.auth',
        'arena.config',
        'arena.console',
        'arena.menu',
        'arena.models',
        'arena.desktop',
        'arena.web',
        'arena.web.app',
        # arena/web/app.py runs these parts in its own namespace (no import
        # statement names them, so PyInstaller must be told to bundle them).
        'arena.web.server',
        'arena.web.server.core',
        'arena.web.server.accounts',
        'arena.web.server.chats',
        'arena.web.server.library',
        'arena.web.server.stream',
        'arena.web.server.turns',
        'arena.web.server.arena_agent',
        'arena.web.server.local_agent',
        'arena.web.server.send',
        'arena.web.server.workspace',
        'arena.web.server.connectors',
        'arena.engine_js',
        'arena.contracts',
        'arena.connectors',
        'arena.history_sync',
        'arena.permissions',
        'arena.crypto',
        'arena.updater',
        'arena.agent',
        'arena.workspace',
        'arena.engine',
        'arena.tools',
        'arena.tools.base',
        'arena.tools.file_tools',
        'arena.tools.shell_tools',
        'arena.tools.browser_mcp',
        'arena.tools.mcp',
        'arena.ui',
        'arena.ui.banner',
        'arena.ui.chat_box',
        'arena.ui.markdown',
        'arena.ui.theme',
        'rich',
        'rich.panel',
        'rich.table',
        'rich.text',
        'rich.markdown',
        'rich.syntax',
        'rich.console',
        'requests',
        'websocket',
        'flask',
        'flask.json',
        'flask.templating',
        'jinja2',
        'markupsafe',
        'werkzeug',
        'webview',
        'webview.platforms.edgechromium',
        'pystray',
        'pystray._win32',
        'PIL',
        'PIL.Image',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=['tkinter', 'matplotlib', 'numpy', 'pandas', 'scipy'],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='Arena-Desktop',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon='assets/arena-cli.ico',
    version='build/version_info.txt' if os.path.exists('build/version_info.txt') else None,
)
